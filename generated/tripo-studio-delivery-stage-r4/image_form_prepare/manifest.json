{
  "id": "tripo.studio.image_form_prepare",
  "provider": "tripo",
  "title": "Tripo Studio image_form_prepare",
  "capabilities": [
    "3d",
    "image_form_prepare"
  ],
  "adapter": "command",
  "executable": "opencliapp",
  "paid": false,
  "permissions": [
    "execute_code",
    "external_write"
  ],
  "schema": {
    "type": "object",
    "properties": {
      "asset_id": {
        "type": "string",
        "pattern": "^(?:[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12})?$"
      },
      "settings": {
        "type": "object",
        "properties": {
          "model": {
            "enum": [
              "GPT Image 2",
              "GPT Image 2.5",
              "Nano Banana Pro",
              "Nano Banana 2",
              "Nano Banana",
              "Midjourney v8.2"
            ]
          },
          "aspect_ratio": {
            "enum": [
              "1:1",
              "16:9",
              "9:16",
              "4:3",
              "3:4",
              null
            ]
          },
          "number_images": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "resolution_4k": {
            "type": "boolean"
          },
          "template": {
            "enum": [
              "Character Extraction",
              "Head Extraction",
              "T Pose",
              "3D Enhance",
              "Character Completion",
              "Photo to Figure",
              "Asset Extraction",
              "Variants",
              "3D Print-Ready",
              null
            ]
          },
          "prompt": {
            "type": "string",
            "minLength": 0,
            "maxLength": 10000
          },
          "expected_draft_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "expected_draft_sha256"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "asset_id",
      "settings"
    ],
    "additionalProperties": false
  },
  "command": {
    "argv": [
      "__opencli_shim",
      "tripo-studio",
      "image-form-prepare",
      "--pin",
      "15aefa19685c025950f4b119c313bb99cd4634d00786bfe3b4809b3aa3e27995",
      "-f",
      "json",
      "--asset",
      {
        "input": "asset_id"
      },
      "--settings",
      {
        "json": "settings"
      }
    ],
    "output": "json",
    "timeout": 240
  },
  "sources": [
    "https://studio.tripo3d.ai/"
  ],
  "notes": "Generate Image form only, separate from image-to-3D. Reviewed model/template choices and typed prompt/ratio/count/4K preparation bind the exact inspected draft digest. Ratios may be unselected; Midjourney hides ratio/count/4K controls and reports null. Existing layers are preserved; close only owned choice layers. No upload, generation, history replay, publishing, raw login state or automatic extra credits.",
  "completion": "Visible draft and available controls are read back, not a paid quote or completed image. Free allowance and detached price text do not establish generation cost. Model changes can hide controls; implicit visible changes are explicit. Configuration may be remembered; restore the approved test draft. Image editing/output acceptance remains separate.",
  "user_defined": true,
  "implementation": "native",
  "verification": "user_installed_not_live_verified"
}
