{
  "id": "tripo.studio.retopo_quote",
  "provider": "tripo",
  "title": "Tripo Studio retopo_quote",
  "capabilities": [
    "3d",
    "retopo_quote"
  ],
  "adapter": "command",
  "executable": "opencliapp",
  "paid": false,
  "permissions": [
    "execute_code",
    "external_write"
  ],
  "schema": {
    "type": "object",
    "properties": {
      "asset_id": {
        "type": "string",
        "pattern": "^[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}$"
      },
      "settings": {
        "type": "object",
        "properties": {
          "topology": {
            "enum": [
              "Quad",
              "Triangle"
            ]
          },
          "polygon_count": {
            "type": "integer",
            "minimum": 500,
            "maximum": 200000
          },
          "smart_mesh": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "required": [
      "asset_id",
      "settings"
    ],
    "additionalProperties": false
  },
  "command": {
    "argv": [
      "__opencli_shim",
      "tripo-studio",
      "retopo-quote",
      "--pin",
      "5f8f7ff375db228367429e54a136490ad64d6d6dd1491f6b18d301d9122ce89b",
      "-f",
      "json",
      "--asset",
      {
        "input": "asset_id"
      },
      "--settings",
      {
        "json": "settings"
      }
    ],
    "output": "json",
    "timeout": 180
  },
  "sources": [
    "https://studio.tripo3d.ai/"
  ],
  "notes": "Visible UI only; exact asset UUID differs from thumbnail preview UUID. Image quote uploads one explicitly approved project raster. Paid calls require current quote, budget, confirmation and shared durable receipt lock. Export delivers a validated GLB file. Scroll scan reports partial unless explicit UI end is observed. No raw auth, private endpoint replay, publication, silent retry or hostile-code isolation.",
  "completion": "Submission is not a finished model; use asset status. Export checks the completed local GLB. Pagination coverage is explicit; a quiet footer is not authoritative completeness.",
  "user_defined": true,
  "implementation": "native",
  "verification": "user_installed_not_live_verified"
}
