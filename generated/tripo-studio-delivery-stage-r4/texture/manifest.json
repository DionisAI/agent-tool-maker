{
  "id": "tripo.studio.texture",
  "provider": "tripo",
  "title": "Tripo Studio texture",
  "capabilities": [
    "3d",
    "texture"
  ],
  "adapter": "command",
  "executable": "opencliapp",
  "paid": true,
  "permissions": [
    "execute_code",
    "external_write"
  ],
  "schema": {
    "type": "object",
    "properties": {
      "asset_id": {
        "type": "string",
        "pattern": "^[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}$"
      },
      "request_key": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.:-]{1,160}$"
      },
      "quote_sha256": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "max_credits": {
        "type": "integer",
        "minimum": 1,
        "maximum": 10000
      },
      "human_confirmed": {
        "type": "boolean",
        "const": true
      }
    },
    "required": [
      "asset_id",
      "request_key",
      "quote_sha256",
      "max_credits",
      "human_confirmed"
    ],
    "additionalProperties": false
  },
  "command": {
    "argv": [
      "__opencli_shim",
      "tripo-studio",
      "texture",
      "--pin",
      "fc6a93664f5119bf8aa1cac622c4b1a3e0b06a5c0eb4b26d7a7b68e33d017187",
      "-f",
      "json",
      "--asset",
      {
        "input": "asset_id"
      },
      "--key",
      {
        "input": "request_key"
      },
      "--ledger",
      {
        "workspace": ""
      },
      "--quote",
      {
        "input": "quote_sha256"
      },
      "--budget",
      {
        "input": "max_credits"
      },
      "--confirm"
    ],
    "output": "json",
    "timeout": 180
  },
  "sources": [
    "https://studio.tripo3d.ai/"
  ],
  "notes": "Texture is the existing reviewed workspace texture contract, not a new provider backend. Status binds one retained project model receipt and its actual output UUID. Unknown submissions and source-only processing remain unresolved; never release their locks or resubmit.",
  "completion": "Provider-ready model is separate from a submitted operation and validated export. Texture/rig/retopo quality and positive real paid acceptance remain distinct. No Cookie, token, profile or unrelated receipt reads.",
  "user_defined": true,
  "implementation": "native",
  "verification": "user_installed_not_live_verified"
}
